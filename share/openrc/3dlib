#
# Gentoo OpenRC init script for 3dlib serve.
#
# Install on ednor (or any OpenRC host):
#   sudo cp /usr/local/3dlib/share/openrc/3dlib /etc/init.d/3dlib
#   sudo chmod 755 /etc/init.d/3dlib
#   sudo cp /usr/local/3dlib/share/openrc/3dlib.conf /etc/conf.d/3dlib
#   # edit /etc/conf.d/3dlib
#   sudo rc-update add 3dlib default
#   sudo rc-service 3dlib start
#
# Reload code after edits (SIGHUP → re-exec, same PID):
#   sudo rc-service 3dlib reload
#
# Do not expose this service to the public internet.

name="3dlib"
description="3dlib 3D model library web UI"

: ${THREEDLIB_BIN:=/usr/local/bin/3dlib}
: ${THREEDLIB_BIND:=0.0.0.0}
: ${THREEDLIB_PORT:=31353}
: ${THREEDLIB_USER:=cgf}
: ${THREEDLIB_GROUP:=cgf}
: ${THREEDLIB_PIDFILE:=/run/${RC_SVCNAME}.pid}
: ${THREEDLIB_LOG:=/var/log/3dlib-serve.log}

command="${THREEDLIB_BIN}"
command_args="serve --bind ${THREEDLIB_BIND} --port ${THREEDLIB_PORT}"
command_user="${THREEDLIB_USER}:${THREEDLIB_GROUP}"
command_background=true
pidfile="${THREEDLIB_PIDFILE}"

# OpenRC will redirect stdout/stderr when these are set (OpenRC 0.21+).
output_log="${THREEDLIB_LOG}"
error_log="${THREEDLIB_LOG}"

extra_started_commands="reload"

depend() {
	# /share/3d and download_dir are on NFS — wait for netmount (see conf.d rc_need).
	need net localmount netmount
	after bootmisc
	use dns logger
}

checkconfig() {
	if [ ! -x "${THREEDLIB_BIN}" ]; then
		eerror "${THREEDLIB_BIN} is missing or not executable"
		return 1
	fi
	if ! getent passwd "${THREEDLIB_USER}" >/dev/null 2>&1; then
		eerror "User ${THREEDLIB_USER} does not exist (edit /etc/conf.d/3dlib)"
		return 1
	fi
	if ! getent group "${THREEDLIB_GROUP}" >/dev/null 2>&1; then
		eerror "Group ${THREEDLIB_GROUP} does not exist (edit /etc/conf.d/3dlib)"
		return 1
	fi
	# Fail early if NFS /share is not actually mounted (stale empty mountpoint).
	libroot="${THREEDLIB_ROOT:-/share/3d}"
	shareroot=$(dirname "${libroot}")
	if [ ! -d "${libroot}" ]; then
		eerror "Library root missing: ${libroot} (is NFS mounted?)"
		return 1
	fi
	if command -v findmnt >/dev/null 2>&1; then
		if ! findmnt -n -t nfs,nfs4 --target /share >/dev/null 2>&1 \
			&& ! findmnt -n -t nfs,nfs4 --target "${shareroot}" >/dev/null 2>&1 \
			&& ! findmnt -n -t nfs,nfs4 --target "${libroot}" >/dev/null 2>&1
		then
			eerror "/share does not look like an NFS mount — start netmount first"
			return 1
		fi
	fi
	return 0
}

start_pre() {
	checkconfig || return $?
	checkpath --file --owner "${THREEDLIB_USER}:${THREEDLIB_GROUP}" \
		--mode 0644 "${THREEDLIB_LOG}" 2>/dev/null || true
	# Launch diagnostics (FreeCAD/Studio open from web + CLI)
	checkpath --file --owner "${THREEDLIB_USER}:${THREEDLIB_GROUP}" \
		--mode 0644 /var/log/3dlib.log 2>/dev/null || true
	# After stop/restart, wait until the listen port is free (avoids
	# background start reporting OK while serve dies with EADDRINUSE).
	_wait_port_free "${THREEDLIB_PORT}" 30
}

stop_pre() {
	# On "restart", refuse to stop if the binary vanished / config is broken.
	if [ "${RC_CMD}" = "restart" ]; then
		checkconfig || return $?
	fi
}

stop_post() {
	# Ensure the old process is gone before OpenRC starts the new one.
	_wait_port_free "${THREEDLIB_PORT}" 50
}

start_post() {
	# command_background=true returns before serve binds; catch silent bind death.
	local i=0
	while [ "$i" -lt 50 ]; do
		if ss -ltn "( sport = :${THREEDLIB_PORT} )" 2>/dev/null | grep -q ":${THREEDLIB_PORT}"; then
			return 0
		fi
		# died?
		if [ -f "${pidfile}" ]; then
			local p
			p=$(cat "${pidfile}" 2>/dev/null || true)
			if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null; then
				eerror "${name} exited before listening on :${THREEDLIB_PORT} (see ${THREEDLIB_LOG})"
				return 1
			fi
		fi
		sleep 0.1
		i=$((i + 1))
	done
	eerror "${name} not listening on :${THREEDLIB_PORT} (see ${THREEDLIB_LOG})"
	return 1
}

# Wait until nothing is listening on TCP port $1 (up to $2 seconds).
_wait_port_free() {
	local port="$1" max="${2:-20}" i=0
	command -v ss >/dev/null 2>&1 || return 0
	while [ "$i" -lt "$max" ]; do
		if ! ss -ltn "( sport = :${port} )" 2>/dev/null | grep -q ":${port}"; then
			return 0
		fi
		sleep 0.1
		i=$((i + 1))
	done
	ewarn "port ${port} still in use after wait — start may fail or retry"
	return 0
}

# Re-exec serve so Perl code reloads. PID is preserved (exec).
# Prefer this over "restart" for code reloads (no port race).
reload() {
	checkconfig || return $?
	ebegin "Reloading ${name} (SIGHUP → re-exec)"
	start-stop-daemon --signal HUP --pidfile "${pidfile}"
	eend $?
}
